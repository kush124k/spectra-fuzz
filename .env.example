# spectra-fuzz environment configuration
# Copy to .env and fill in values

# Required: Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-api-key-here

# Optional: Override default models
# SPECTRA_LLM_FAST_MODEL=gemini-2.5-flash
# SPECTRA_LLM_DEEP_MODEL=gemini-2.5-pro

# Optional: API budget limits
# SPECTRA_LLM_MAX_CALLS_PER_HOUR=200
# SPECTRA_LLM_MAX_TOKENS_PER_HOUR=500000

# Optional: WSL distribution name (if not default)
# SPECTRA_WSL_DISTRO=Ubuntu

# Optional: Dashboard settings
# SPECTRA_DASHBOARD_HOST=127.0.0.1
# SPECTRA_DASHBOARD_PORT=8077
